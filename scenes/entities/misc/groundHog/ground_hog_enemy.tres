code = "shader_type canvas_item;
render_mode blend_mix;

uniform float scale;
uniform sampler2D head;
uniform int sprite_amount;
uniform sampler2D body;



void fragment() {
// Input:6
	vec2 n_out6p0 = UV;


// VectorDecompose:8
	float n_out8p0 = vec3(n_out6p0, 0.0).x;
	float n_out8p1 = vec3(n_out6p0, 0.0).y;
	float n_out8p2 = vec3(n_out6p0, 0.0).z;


// FloatParameter:24
	float n_out24p0 = scale;


// FloatOp:23
	float n_out23p0 = n_out8p1 * n_out24p0;


// FloatConstant:11
	float n_out11p0 = 30.000000;


// FloatOp:12
	float n_in12p0 = 1.00000;
	float n_out12p0 = n_in12p0 / n_out11p0;


// Compare:17
	bool n_out17p0 = n_out23p0 <= n_out12p0;


// FloatOp:7
	float n_out7p0 = mod(n_out23p0, n_out12p0);


// FloatOp:10
	float n_out10p0 = n_out7p0 * n_out11p0;


// VectorCompose:9
	float n_in9p2 = 0.00000;
	vec3 n_out9p0 = vec3(n_out8p0, n_out10p0, n_in9p2);


	vec4 n_out46p0;
// Texture2D:46
	n_out46p0 = texture(head, vec2(n_out9p0.xy));


// VectorDecompose:33
	float n_out33p0 = vec2(n_out9p0.xy).x;
	float n_out33p1 = vec2(n_out9p0.xy).y;


// IntParameter:31
	int n_out31p0 = sprite_amount;


// FloatOp:34
	float n_in34p0 = 1.00000;
	float n_out34p0 = n_in34p0 / float(n_out31p0);


// Input:42
	float n_out42p0 = TIME;


// FloatConstant:43
	float n_out43p0 = 15.000000;


// FloatOp:44
	float n_out44p0 = n_out42p0 * n_out43p0;


// IntOp:41
	int n_out41p0 = int(n_out44p0) % n_out31p0;


// FloatOp:40
	float n_out40p0 = n_out34p0 * float(n_out41p0);


// MultiplyAdd:39
	float n_out39p0 = fma(n_out33p1, n_out34p0, n_out40p0);


// VectorCompose:35
	vec2 n_out35p0 = vec2(n_out33p0, n_out39p0);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(body, n_out35p0);


	vec4 n_out13p0;
// Switch:13
	n_out13p0 = mix(n_out3p0, n_out46p0, float(n_out17p0));


// VectorDecompose:14
	float n_out14p0 = n_out13p0.x;
	float n_out14p1 = n_out13p0.y;
	float n_out14p2 = n_out13p0.z;
	float n_out14p3 = n_out13p0.w;


// VectorCompose:15
	vec3 n_out15p0 = vec3(n_out14p0, n_out14p1, n_out14p2);


// Output:0
	COLOR.rgb = n_out15p0;
	COLOR.a = n_out14p3;


}
